# docker-compose 용 환경변수 예시.
# 복사해서 사용:  cp .env.example .env   (값을 바꾸면 compose가 자동으로 읽음)
# .env 는 커밋하지 말 것(로컬 설정/비밀번호).

# ── Oracle ──
ORACLE_PORT=1522            # host 포트 (다른 Oracle 컨테이너 1521과 충돌 방지)
ORACLE_SYS_PASSWORD=oracle  # SYS/SYSTEM 비밀번호
DB_USERNAME=devtrack        # 앱 전용 계정
DB_PASSWORD=devtrack

# ── Ollama ──
OLLAMA_PORT=11435                              # host 포트 (네이티브 ollama 11434와 충돌 방지)
OLLAMA_MODELS_DIR=D:/data/ollama_data/models   # 이 PC에 이미 받아 둔 모델 폴더(재사용)
